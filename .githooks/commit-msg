#!/usr/bin/env bash
# harness-template: commit-msg/cpanel v2 — written by repo-files-lock.mjs; spoke-upgrade and harness-lint read it. Keep it when you tune this gate.
# commit-msg — cPanel/WHM flavour. A RATCHET, not a wall.
#
# Unlike the other two flavours, no regex for the cPanel format existed anywhere before this file.
# The rules are prose in engineering-commit/references/cpanel.md, and a gate written straight from
# that prose rejects about a third of what the team actually commits.
#
# Measured against app-elevate-cpanel's last 200 non-merge commits at 64f1fa6, 2026-09-30 (re-measured
# here, as the header below requires — the hub's own numbers do not transfer):
#
#   rule                            compliance    gating it hard would
#   ------------------------------  -----------   -------------------------------
#   no case number in line 1         99.5%        reject 1/200
#   `Case XXX-N:` in the body        49.5%        reject 101/200 (48 of them are the release
#                                                  and version-bump commits `make release` writes)
#   subject <= 50 characters           79%         reject 42/200
#
# Rule 1 clears HARDEN_AT (95); the team keeps it at warn until it chooses to promote it. The other
# two stay warn.
#
# ⚠️ THE LEVELS BELOW ARE THE TEAM'S DECISION, NOT THIS FILE'S.
# Re-measure on the repository you are installing into — do not trust the numbers above for a
# different repo — then set each level from what you find. A rule left at "warn" with no trigger is
# a rule nobody will ever harden, so the trigger is measured rather than diarised: see HARDEN_AT.
#
# Enable once per clone (this cannot be committed):
#   git config core.hooksPath .githooks
set -euo pipefail

# ── Ratchet levels ───────────────────────────────────────────────────────────
# hard = reject the commit   warn = print and allow   off = do not check
#
# The percentages above are from REPLAYING THIS FILE's rules over this repository's last 200
# non-merge commits, 2026-09-30 — not from reading the prose that describes the format. Re-measure this repo again before changing any level below.
#
# A rule hardens when it MEASURES clean, not on a date somebody picked. Re-run the replay; when a
# rule holds at HARDEN_AT or better over the trailing window, promote it and record that you did.
HARDEN_AT=95                      # percent, over the trailing 200 non-merge commits
LEVEL_NO_CASE_IN_SUBJECT="warn"   # measured 99.5% (199/200) — clears HARDEN_AT; promotion is the team's call
LEVEL_BODY_CASE_LINE="warn"       # measured 49.5% (99/200) — required for PR-bound work, skippable for
                                   # a direct-to-main fixup; warn reminds without blocking either
LEVEL_SUBJECT_LENGTH="warn"       # measured 79% (158/200)
SUBJECT_MAX=50

# Identifiers shaped like a case key that never are one. Replaying 3000 cpanel-whm subjects
# (140, 2026-10-14) through the old `[A-Z]{2,}-[0-9]+` match rejected 8 with no case in them:
# CVE-2026-3381, CWE-78, PTT-2025-021, UTF-8, Net-CIDR-0.27, Whostmgr-API-1. A key now has to be
# a whole word, which clears the CVE, CIDR, API and PTT ones; this list clears the rest. ADR is the
# hubs' decision record (ADR-002). Add a prefix here when your replay finds one.
NOT_A_CASE="ADR|CVE|CWE|UTF"

# Documented in cpanel.md but deliberately NOT checked: "line 2 must be blank". It was never
# measured, and a gap is recorded rather than invented. Measure it before adding it.

msg_file="$1"
# The first line that is neither blank nor a comment. awk reads the file itself and stops there:
# `grep | head -n 1` under pipefail exits 141 on a long message (head quits, grep gets SIGPIPE),
# and set -e then aborts the hook (T66).
header=$(awk '!/^[[:space:]]*(#|$)/ { print; exit }' "$msg_file")
body=$(grep -vE '^\s*#' "$msg_file" | tail -n +2)

case "$header" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

fail=0
warned=0

report() { # $1=level  $2=message  $3=hint
  case "$1" in
    hard) echo "commit-msg: $2" >&2; echo "  $3" >&2; fail=1 ;;
    warn) echo "commit-msg [warning]: $2" >&2; echo "  $3" >&2; warned=1 ;;
  esac
}

# 1 — the case number belongs in the body, never in the summary line.
if [ "$LEVEL_NO_CASE_IN_SUBJECT" != "off" ]; then
  # One word per line (a hyphen stays inside its word), then whole-word keys only. Jira project
  # keys may carry a digit (CP2-58). No `grep -q` in the pipe: every stage reads to the end (T66).
  case_keys=$(tr -cs 'A-Za-z0-9_-' '\n' <<<"$header" \
    | grep -xE '[A-Z][A-Z0-9_]+-[0-9]+' | grep -vxE "($NOT_A_CASE)-[0-9]+" || true)
  if [ -n "$case_keys" ]; then
    report "$LEVEL_NO_CASE_IN_SUBJECT" \
      "the summary line carries a case number ($(tr '\n' ' ' <<<"$case_keys" | sed 's/ $//'))." \
      "Move it to the body, on its own line: Case CPANEL-1234: <what and why>"
  fi
fi

# 2 — the body carries the case reference.
if [ "$LEVEL_BODY_CASE_LINE" != "off" ]; then
  # A here-string, not `printf | grep -q`: grep -q quits at the first match, printf gets SIGPIPE, and
  # under pipefail a long body with an early Case line read as "no Case line" (T66).
  if ! grep -qE '^Case [A-Z][A-Z0-9_]+-[0-9]+:' <<<"$body"; then
    report "$LEVEL_BODY_CASE_LINE" \
      "no 'Case XXX-1234:' line in the body." \
      "Third line of the message: Case CPANEL-1234: <what changed, why, what was rejected>"
  fi
fi

# 3 — a short summary. Many git commands show only this line.
if [ "$LEVEL_SUBJECT_LENGTH" != "off" ]; then
  len=${#header}
  if [ "$len" -gt "$SUBJECT_MAX" ]; then
    report "$LEVEL_SUBJECT_LENGTH" \
      "the summary is $len characters; the convention is $SUBJECT_MAX or fewer." \
      "Use the imperative mood and put the detail in the body: 'Fix X', not 'Fixed X because Y'."
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "  got: $header" >&2
  exit 1
fi

# A warning never blocks. That is the point of a ratchet: the gate reports the gap today and is
# hardened on a date the team agreed, rather than rejecting a third of their work on day one.
if [ "$warned" -ne 0 ]; then
  echo "commit-msg: committed anyway — the rules above are warnings in this repository." >&2
fi
exit 0
