#!/usr/local/cpanel/3rdparty/bin/perl

use constant ELEVATE_LOG_PATH => '/var/log/elevate-cpanel.log';
use constant ELEVATE_PID      => '/var/run/elevate-cpanel.pid';

use JSON::PP;
use POSIX;

_exit_with_haste(1) if !length( $ENV{REBOOT_STRING} );

open( my $elevate_log_fh, '<', ELEVATE_LOG_PATH ) or die "## [ERROR][reboot_watch]: Unable to open ELEVATE_LOG_PATH: $!\n";

while ( my $line = readline $elevate_log_fh ) {

    # --check failed so there is no status
    # just exit in this case
    _exit_with_haste(1) if $line =~ /Please fix the detected issues before performing the elevation process/ && !_script_is_running();

    if ( index( $line, $ENV{REBOOT_STRING} ) >= 0 ) {
        close $elevate_log;
        _pre_success_message();
        _exit_with_haste_(0);
    }
}

# Capture the byte offset where the sequential read stopped so the
# follow-up `tail` can resume from exactly that point.  Without this,
# `tail` would start at its own idea of EOF (set when tail spawns) and
# anything written between this close and the tail spawn would be lost.
my $resume_offset = tell($elevate_log_fh);
close $elevate_log_fh;

_check_elevate_log_for_REBOOT_STRING( ELEVATE_LOG_PATH, $ENV{REBOOT_STRING}, $resume_offset );
_exit_with_haste(1);

sub _check_elevate_log_for_REBOOT_STRING {
    my ( $filepath, $REBOOT_STRING, $resume_offset ) = @_;
    $resume_offset //= 0;

    my $has_continued = 0;

    # Bail out if elevate-cpanel goes silent for too long without
    # logging either the reboot string or an [ERROR] / [FATAL] -- e.g.
    # the post-reboot service never re-launches it.  Without this,
    # the only failure signal is appleboy/ssh-action's command_timeout
    # firing 30-60 minutes later, which surfaces as a generic
    # "Run Command Timeout" instead of a script failure.
    my $no_activity_timeout = 15 * 60;
    my $last_activity       = time();
    $SIG{ALRM} = sub {
        my $idle = time() - $last_activity;
        if ( $idle >= $no_activity_timeout ) {
            my $t = POSIX::strftime( "%Y-%m-%d %H:%M:%S", localtime );
            print "## [$t] [ERROR]: No /var/log/elevate-cpanel.log activity for ${idle}s; treating elevate-cpanel as hung.\n";
            _exit_with_haste(1);
        }
        alarm 60;
    };
    alarm 60;

    # Use GNU `tail -F` via a pipe rather than File::Tail.  File::Tail's
    # adaptive userspace polling was observed silently missing a write on
    # CL7 stage 5 (run 27013630697); coreutils tail uses inotify on Linux
    # and does not have that failure mode.  `-c +N` resumes at byte N
    # (1-based) so we pick up exactly where the preceding sequential read
    # stopped -- closing the close-vs-spawn TOCTOU window.
    my $tail_start = $resume_offset + 1;
    open( my $tail_fh, '-|', '/usr/bin/tail', '-c', "+$tail_start", '-F', $filepath )
      or do {
        my $t = POSIX::strftime( "%Y-%m-%d %H:%M:%S", localtime );
        print "## [$t] [ERROR]: Failed to spawn tail -F on $filepath: $!\n";
        _exit_with_haste(1);
      };

    while ( defined( my $line = <$tail_fh> ) ) {
        $last_activity = time();

        # --check failed so there is no status
        # just exit in this case
        _exit_with_haste(1) if $line =~ /Please fix the detected issues before performing the elevation process/;

        # Lines that match ERROR or FATAL are an indication that the script
        # has failed or is about to fail
        if ( $line =~ /\[(?:ERROR|FATAL|No valid license found\.)\]|You can continue the process after fixing the errors by running|The elevation process failed/ ) {
            if ( _script_has_failed() ) {

                # If it failed due to temporary mirror issues,
                # then it may take a minute or two for the mirrors to be stable again
                sleep 60;

                $has_continued ? _exit_with_haste(1) : _restart_script();
                $has_continued = 1;
            }
        }

        if ( index( $line, $ENV{REBOOT_STRING} ) >= 0 ) {
            _success_message();
            _exit_with_haste(0);
        }
    }
}

sub _script_is_running {

    open( my $fh, '<', '/var/cpanel/elevate' ) or _exit_with_haste(1);
    my $raw_content = do { local $/; <$fh>; };
    close $fh;

    my $elevate_data   = JSON::PP->new->decode($raw_content);
    my $elevate_status = $elevate_data->{status};
    return $elevate_status eq 'running' ? 1 : 0;
}

sub _script_has_failed {

    # This is too slow (~.57 seconds to make it as a system call)
    # So we are going pull this data out of '/var/cpanel/elevate' directly
    # (~.007 seconds to pull the data out of the json file) which is
    # what the script is doing
    # my $status = `/scripts/elevate-cpanel --status`;
    # chomp $status;

    open( my $fh, '<', '/var/cpanel/elevate' ) or _exit_with_haste(1);
    my $raw_content = do { local $/; <$fh>; };
    close $fh;

    my $elevate_data   = JSON::PP->new->decode($raw_content);
    my $elevate_status = $elevate_data->{status};
    return $elevate_status eq 'failed' ? 1 : 0;
}

sub _restart_script {
    my $pid = fork();
    _exit_with_haste(1) unless defined $pid;
    if ($pid) {
        my $time = POSIX::strftime( "%Y-%m-%d %H:%M:%S", localtime );
        print "## [$time] [WARN]: elevate-cpanel failed.  Attempting to restart the script to see if the failure was due to a temporary issue ##\n";

        waitpid( $pid, 0 );
        return;
    }
    else {

        # release the pid so the service can use it
        unlink ELEVATE_PID;

        # Do it this way so that this process goes away since --continue
        # will follow the elevate log afterwards
        system( '/usr/bin/systemctl', 'start', 'elevate-cpanel.service' );
        exit 0;
    }

    return;
}

sub _pre_success_message {
    my $time = POSIX::strftime( "%Y-%m-%d %H:%M:%S", localtime );
    print "## [$time] [INFO][PRE-TAIL]: SUCCESS: Reboot REBOOT_STRING ( $ENV{REBOOT_STRING} ) already exists in /var/log/elevate-cpanel.log prior to tail.  Timings may be off  ##\n";
    _exit_with_haste(0);
}

sub _success_message {
    my $time = POSIX::strftime( "%Y-%m-%d %H:%M:%S", localtime );
    print "## [$time] [INFO]: SUCCESS: Reboot REBOOT_STRING ( $ENV{REBOOT_STRING} ) found in /var/log/elevate-cpanel.log  ##\n";
    _exit_with_haste(0);
}

sub _exit_with_haste {
    my $code = shift;
    print "## [INFO]: Attempting to kill tail and exit_code($code) stage left. ##\n";

    # Kill the backgrounded "tail -F /var/log/elevate-cpanel.log" left running
    # by the surrounding workflow script.  Match on the exact process name
    # ("tail") rather than --full / cmdline substring: drone-ssh runs the
    # workflow script via `bash -c "<entire script body>"`, so the bash
    # process's cmdline contains the tail command string, and a --full match
    # would SIGKILL our own shell before it can run the remaining steps
    # (e.g. `shutdown -r +0 &`).
    eval { system(qq{pkill --signal 9 --exact tail}) };
    print $@ if $@;
    exit $code;
}

1;
